{
  "name": "cawme",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "start:clean": "expo start --dev-client --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "ios:clean": "xcodebuild clean -workspace ios/Cawme.xcworkspace -scheme Cawme -quiet && expo run:ios",
    "web": "expo start --web",
    "check-locales": "node ./scripts/check-locales.js",
    "postinstall": "node ./scripts/patch-expo-modules-core-swift.js",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest src/modules/auth/hooks/__tests__",
    "test:monkey": "maestro test .maestro/flows/monkey-test.yaml",
    "test:stress": "maestro test .maestro/flows/stress-test.yaml",
    "test:e2e": "maestro test .maestro/flows/register-flow.yaml && maestro test .maestro/flows/login-flow.yaml && maestro test .maestro/flows/verification-flow.yaml",
    "test:e2e:all": "maestro test .maestro/flows/*.yaml",
    "test:e2e:happy": "maestro test .maestro/flows/register-flow.yaml && maestro test .maestro/flows/register-with-cnpj-flow.yaml && maestro test .maestro/flows/register-with-rg-flow.yaml && maestro test .maestro/flows/register-with-passport-flow.yaml && maestro test .maestro/flows/register-as-provider-flow.yaml && maestro test .maestro/flows/register-full-cep-verification-flow.yaml && maestro test .maestro/flows/address-autocomplete-flow.yaml",
    "test:e2e:errors": "maestro test .maestro/flows/register-error-validation-flow.yaml && maestro test .maestro/flows/register-error-duplicate-email-flow.yaml && maestro test .maestro/flows/register-error-duplicate-phone-flow.yaml && maestro test .maestro/flows/register-error-duplicate-document-flow.yaml && maestro test .maestro/flows/address-error-cep-not-found-flow.yaml && maestro test .maestro/flows/verification-error-wrong-code-flow.yaml && maestro test .maestro/flows/login-error-wrong-credentials-flow.yaml",
    "test:register": "maestro test .maestro/flows/register-flow.yaml",
    "test:register:cnpj": "maestro test .maestro/flows/register-with-cnpj-flow.yaml",
    "test:register:rg": "maestro test .maestro/flows/register-with-rg-flow.yaml",
    "test:register:passport": "maestro test .maestro/flows/register-with-passport-flow.yaml",
    "test:register:provider": "maestro test .maestro/flows/register-as-provider-flow.yaml",
    "test:register:full": "maestro test .maestro/flows/register-full-cep-verification-flow.yaml",
    "test:register:err:validation": "maestro test .maestro/flows/register-error-validation-flow.yaml",
    "test:register:err:email": "maestro test .maestro/flows/register-error-duplicate-email-flow.yaml",
    "test:register:err:phone": "maestro test .maestro/flows/register-error-duplicate-phone-flow.yaml",
    "test:register:err:document": "maestro test .maestro/flows/register-error-duplicate-document-flow.yaml",
    "test:login": "maestro test .maestro/flows/login-flow.yaml",
    "test:login:err": "maestro test .maestro/flows/login-error-wrong-credentials-flow.yaml",
    "test:verification": "maestro test .maestro/flows/verification-flow.yaml",
    "test:verification:err": "maestro test .maestro/flows/verification-error-wrong-code-flow.yaml",
    "test:address:autocomplete": "maestro test .maestro/flows/address-autocomplete-flow.yaml",
    "test:address:err:cep": "maestro test .maestro/flows/address-error-cep-not-found-flow.yaml",
    "test:resume": "maestro test .maestro/flows/registration-resume-flow.yaml",
    "test:address-map": "maestro test .maestro/flows/address-map-picker-flow.yaml",
    "test:blocked": "maestro test .maestro/flows/blocked-account-flow.yaml",
    "test:document": "maestro test .maestro/flows/document-upload-flow.yaml",
    "test:maestro:status": "maestro status",
    "test:maestro:devices": "maestro list-devices"
  },
  "dependencies": {
    "@gorhom/bottom-sheet": "^5.2.9",
    "@hookform/resolvers": "^5.2.2",
    "@sentry/react-native": "^8.10.0",
    "@tanstack/react-query": "^5.99.0",
    "axios": "^1.15.0",
    "expo": "^55.0.15",
    "expo-auth-session": "~55.0.14",
    "expo-camera": "~55.0.15",
    "expo-constants": "~55.0.14",
    "expo-crypto": "~55.0.14",
    "expo-document-picker": "~55.0.13",
    "expo-image": "~55.0.8",
    "expo-image-picker": "~55.0.18",
    "expo-linking": "~55.0.13",
    "expo-location": "~55.1.8",
    "expo-modules-core": "^55.0.23",
    "expo-notifications": "~55.0.19",
    "expo-router": "~55.0.12",
    "expo-secure-store": "~55.0.13",
    "expo-status-bar": "~55.0.5",
    "expo-updates": "~55.0.20",
    "nativewind": "^4.2.3",
    "react": "19.2.0",
    "react-hook-form": "^7.72.1",
    "react-native": "0.83.4",
    "react-native-gesture-handler": "~2.30.0",
    "react-native-maps": "1.27.2",
    "react-native-mmkv": "^3.3.3",
    "react-native-reanimated": "4.2.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.23.0",
    "react-native-svg": "15.15.3",
    "react-native-worklets": "^0.7.4",
    "socket.io-client": "^4.8.3",
    "zod": "^4.3.6",
    "zustand": "^5.0.12"
  },
  "private": true,
  "overrides": {
    "react-dom": "19.2.0",
    "react-test-renderer": "19.2.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.4.0",
    "@testing-library/react-native": "^13.3.3",
    "@types/react": "~19.2.10",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^10.2.0",
    "jest": "^29.7.0",
    "jest-expo": "^55.0.16",
    "msw": "^2.13.4",
    "prettier": "^3.8.3",
    "typescript": "~5.9.3"
  }
}
